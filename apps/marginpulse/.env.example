# MarginPulse — optional lead-capture config (Vite env; copy to .env.local)

# Where the "Request a free profit audit" form POSTs.
# Use a JSON form endpoint that returns { "success": true }.
# Leave blank to fall back to a mailto: link using VITE_CONTACT_EMAIL.
VITE_LEAD_ENDPOINT=

# Fallback / direct contact email shown when no endpoint is set.
VITE_CONTACT_EMAIL=kostinmihail40@gmail.com
