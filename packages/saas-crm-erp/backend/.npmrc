# @nestjs/cache-manager@2.x declares a peer of @nestjs/common ^9||^10 but the
# app runs on NestJS 11, so strict peer resolution makes `npm install`/`npm ci`
# fail. This is a temporary bridge so installs are reproducible; the proper fix
# is bumping @nestjs/cache-manager to v3 (Keyv-based) — tracked in the deps
# phase of docs/HARDENING_ROADMAP.md.
legacy-peer-deps=true
