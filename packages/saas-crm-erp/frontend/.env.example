# ---- Frontend environment (Next.js) ----
# Copy to `.env.local` for local development: cp .env.example .env.local
# Only NEXT_PUBLIC_* vars are exposed to the browser — never put secrets here.

# Base URL of the backend API (NestJS). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public base URL of this frontend app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe publishable key (safe to expose; the secret key lives in the backend).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Disable Next.js anonymous telemetry in CI/dev.
NEXT_TELEMETRY_DISABLED=1
