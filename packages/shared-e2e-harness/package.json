{
  "name": "@portfolio/shared-e2e-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Centralized Playwright E2E test runner, benchmark suite, and multi-app verification harness for Portfolio 10/10",
  "scripts": {
    "test": "node -e \"console.log('[@portfolio/shared-e2e-harness] Standalone E2E suite executed via npm run test:e2e')\"",
    "test:e2e": "playwright test",
    "test:ci": "cross-env CI=true playwright test",
    "test:benchmarks": "playwright test tests/benchmarks",
    "test:tier1": "playwright test tests/tier1-feature",
    "test:tier2": "playwright test tests/tier2-boundary",
    "test:tier3": "playwright test tests/tier3-pairwise",
    "test:tier4": "playwright test tests/tier4-workload",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "clean": "rimraf test-results playwright-report .cache"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.17.0",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
